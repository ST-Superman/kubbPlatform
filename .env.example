# Supabase — Project Settings → API (or → Data API + API Keys)
# Safe to expose to the browser (NEXT_PUBLIC_*). RLS is what protects your data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLISHABLE-KEY

# Optional: used by transactional email / redirect URLs in later phases.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe — membership checkout + webhook (SERVER-ONLY, never NEXT_PUBLIC).
# Use a restricted key (rk_...): Checkout Sessions + Customers write, Prices read.
STRIPE_SECRET_KEY=rk_test_...
# Signing secret from the webhook endpoint (Stripe dashboard) or `stripe listen`.
STRIPE_WEBHOOK_SECRET=whsec_...
# Price id of the "Kubb Portal — 12 Months" product ($5.99, one-time).
STRIPE_PRICE_ID=price_...

# Supabase service role key (SERVER-ONLY). The Stripe webhook uses it to credit
# memberships (bypasses RLS). Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
